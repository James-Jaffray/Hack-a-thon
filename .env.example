# Copy to .env and fill in. .env is gitignored: real secrets never go in git.

# Database. DB_HOST/DB_PORT are for `pnpm dev` on your laptop;
# inside Docker the app talks to the db container directly.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=calhub
DB_USER=postgres
DB_PASS=change-me

PORT=3000
# Long random string. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Google sign-in (optional in dev). The redirect URI must match one listed in Google Cloud Console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Production only (the Synology's .env). Leave these out in dev. ---
# NODE_ENV=production
# COOKIE_SECURE=true
# GOOGLE_REDIRECT_URI=https://calhub.cc/auth/google/callback
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=<from Cloudflare Zero Trust, never commit>
